<link rel="stylesheet" href="../css/style.css">

<div class="site-wrap">
  <nav class="site-nav">
    <a href="../" class="nav-brand" aria-label="SLOSH Lab home">
      <img src="{{ '/images/logo/SLOSH_Logo.png' | url }}" alt="SLOSH Lab" class="nav-logo">
    </a>
    <div class="nav-links">
      <a href="../">Home</a>
      <a href="../projects/">Projects</a>
      <a href="./" class="active">Publications</a>
      <a href="../gallery/">Gallery</a>
      <a href="../team/">Team</a>
    </div>
  </nav>

  <main class="page-main">
    <section class="section">
      <h1>Publications</h1>
      <p class="section-subtitle">Use the topic links below to jump through the publication list.</p>

      <div class="pill-row publication-topic-nav">
        {% for group in publicationGroups %}
        <a class="pill" href="#{{ group.id }}">{{ group.label }}</a>
        {% endfor %}
      </div>

      {% for group in publicationGroups %}
      <section id="{{ group.id }}" class="publication-section">
        <h2 class="divider-title">{{ group.label }}</h2>

        <div class="publication-list">
          {% if group.items and group.items.length %}
          {% for item in group.items %}
          <article class="publication-item">
            <h3>{{ item.title }}</h3>
            {% if item.description %}
            <p class="publication-description">{{ item.description }}</p>
            {% endif %}
            {% if item.details %}
            <p class="publication-citation">{{ item.details }}</p>
            {% else %}
            <p class="muted">Details coming soon.</p>
            {% endif %}
            {% if item.link %}
            <div class="publication-actions">
              <a class="button button-primary" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">Read more</a>
            </div>
            {% endif %}
          </article>
          {% endfor %}
          {% else %}
          <article class="publication-item">
            <h3>Coming soon</h3>
            <p class="muted">Publications for this topic will appear here.</p>
          </article>
          {% endif %}
        </div>
      </section>
      {% endfor %}
    </section>
  </main>
</div>